# ================================
# KANDIANE - Configuration Environment Variables
# ================================
# Copiez ce fichier vers .env et remplissez les valeurs
# IMPORTANT: Ne JAMAIS committer le fichier .env dans Git!
# ================================

# ================================
# DJANGO CORE SETTINGS
# ================================

# OBLIGATOIRE: Clé secrète Django (générez-en une nouvelle pour chaque environnement)
# Générer avec: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=changez-moi-par-une-vraie-cle-secrete-unique

# Environment: development, production, test
DJANGO_SETTINGS_MODULE=config.settings.development

# Mode debug (True pour développement, False pour production)
# ATTENTION: TOUJOURS False en production!
DEBUG=True

# Hosts autorisés (séparés par des virgules)
# Développement: localhost,127.0.0.1
# Production: votredomaine.com,www.votredomaine.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ================================
# DATABASE CONFIGURATION
# ================================

# URL de connexion à la base de données
# SQLite (développement): sqlite:///db.sqlite3
# PostgreSQL (production): postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Exemple PostgreSQL: postgres://kandiane_user:motdepasse@localhost:5432/kandiane_db
DATABASE_URL=sqlite:///db.sqlite3

# ================================
# EMAIL CONFIGURATION
# ================================

# Backend email
# Développement: django.core.mail.backends.console.EmailBackend
# Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Configuration SMTP (requis seulement si EMAIL_BACKEND = smtp)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Identifiants SMTP
EMAIL_HOST_USER=votre-email@example.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application

# Email par défaut pour l'envoi
DEFAULT_FROM_EMAIL=noreply@example.com

# ================================
# SITE CONFIGURATION
# ================================

# URL de base du site
# Développement: http://localhost:8000
# Production: https://votredomaine.com
SITE_URL=http://localhost:8000

# Nom de l'association (affiché dans les emails et l'interface)
SITE_NAME=Nom de votre association

# ================================
# SECURITY SETTINGS (Production uniquement)
# ================================

# Ces paramètres sont automatiquement configurés dans production.py
# Décommenter et ajuster si nécessaire:

# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# ================================
# OPTIONAL SETTINGS
# ================================

# Mode maintenance (True pour activer)
# MAINTENANCE_MODE=False

# Durée de session en secondes (défaut: 7200 = 2 heures)
# SESSION_COOKIE_AGE=7200

# Durée d'inactivité avant déconnexion en secondes (défaut: 1800 = 30 minutes)
# SESSION_IDLE_TIMEOUT=1800

# ================================
# CELERY CONFIGURATION (Optionnel - pour tâches asynchrones)
# ================================

# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ================================
# LOGGING & MONITORING (Optionnel)
# ================================

# Sentry DSN pour monitoring des erreurs
# SENTRY_DSN=https://votre-cle@sentry.io/votre-projet

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# ================================
# THIRD-PARTY SERVICES (Optionnel)
# ================================

# AWS S3 pour stockage de fichiers (optionnel)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=

# ================================
# NOTES IMPORTANTES
# ================================
#
# 1. SÉCURITÉ:
#    - Ne JAMAIS committer le fichier .env dans Git
#    - Utiliser des mots de passe forts et uniques
#    - Générer une nouvelle SECRET_KEY pour chaque environnement
#    - Activer HTTPS en production
#
# 2. EMAIL:
#    - Pour Gmail, créer un "mot de passe d'application":
#      https://myaccount.google.com/apppasswords
#    - Ne pas utiliser votre mot de passe principal
#
# 3. DATABASE:
#    - SQLite convient pour développement et petites apps
#    - PostgreSQL recommandé pour production
#    - Faire des backups réguliers en production
#
# 4. DÉPLOIEMENT:
#    - Utiliser config.settings.production en production
#    - Vérifier que DEBUG=False
#    - Configurer ALLOWED_HOSTS correctement
#    - Activer toutes les options de sécurité HTTPS
#
# ================================
